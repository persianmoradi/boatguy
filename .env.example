# Quote form email (copy to .env locally; set the same variables on the host).
# Resend API key, from a Resend account on the client's domain (resend.com).
RESEND_API_KEY=
# Sender: an address on a domain verified in Resend, e.g. "TheBoatGuy.dk <tilbud@theboatguy.dk>"
QUOTE_FROM=
# Where requests go (defaults to info@theboatguy.dk)
QUOTE_TO=info@theboatguy.dk
