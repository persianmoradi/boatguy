---
// Before/after comparison. Pointer and touch: drag sideways or tap to move the divider; a vertical swipe scrolls
// the page as usual (touch-action: pan-y). Keyboard and screen readers use the visually hidden range input.
interface Props {
  before: string;
  after: string;
  beforeAlt: string;
  afterAlt: string;
  beforeLabel: string;
  afterLabel: string;
  compareLabel: string;
  class?: string;
}
const { before, after, beforeAlt, afterAlt, beforeLabel, afterLabel, compareLabel, class: cls = '' } = Astro.props;
---
<div class:list={['ba group relative isolate cursor-ew-resize touch-pan-y overflow-hidden rounded-[var(--radius-card)] bg-surface select-none', cls]} style="--pos: 50%" data-ba>
  <img src={after} alt={afterAlt} loading="lazy" class="absolute inset-0 h-full w-full object-cover" draggable="false" />
  <div class="absolute inset-0 [clip-path:inset(0_calc(100%-var(--pos))_0_0)]">
    <img src={before} alt={beforeAlt} loading="lazy" class="absolute inset-0 h-full w-full object-cover" draggable="false" />
  </div>

  <span class="pointer-events-none absolute left-4 top-4 rounded-full bg-white px-3 py-1 text-xs font-semibold text-navy-950" aria-hidden="true">{beforeLabel}</span>
  <span class="pointer-events-none absolute right-4 top-4 rounded-full bg-white px-3 py-1 text-xs font-semibold text-navy-950" aria-hidden="true">{afterLabel}</span>

  <!-- the divider and its handle -->
  <div class="pointer-events-none absolute inset-y-0 left-[var(--pos)] w-px -translate-x-1/2 bg-white shadow-[0_0_0_1px_rgb(4_28_61/0.15)]" aria-hidden="true">
    <span class="absolute left-1/2 top-1/2 grid h-11 w-11 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white text-navy-950 shadow-[0_10px_30px_-10px_rgb(4_28_61/0.4)] group-has-[:focus-visible]:outline-2 group-has-[:focus-visible]:outline-offset-4 group-has-[:focus-visible]:outline-blue-600">
      <svg width="22" height="12" viewBox="0 0 22 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 1 1 6l5 5M16 1l5 5-5 5" /></svg>
    </span>
  </div>

  <input type="range" min="0" max="100" value="50" step="1" aria-label={compareLabel} class="sr-only" data-ba-input />
</div>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((ba) => {
    const input = ba.querySelector<HTMLInputElement>('[data-ba-input]')!;
    const set = (v: number) => ba.style.setProperty('--pos', `${v}%`);
    input.addEventListener('input', () => set(Number(input.value)));

    // drag or tap: the browser keeps vertical swipes for scrolling, so these only see sideways movement
    // mouse: press and drag. touch: a sideways move drags, an up/down move is left to scrolling, a clean tap jumps.
    let start: { x: number; y: number; touch: boolean } | null = null;
    let dragging = false;
    const moveTo = (clientX: number) => {
      const r = ba.getBoundingClientRect();
      const v = Math.round(Math.min(100, Math.max(0, ((clientX - r.left) / r.width) * 100)));
      input.value = String(v);
      set(v);
    };
    ba.addEventListener('pointerdown', (e) => {
      start = { x: e.clientX, y: e.clientY, touch: e.pointerType !== 'mouse' };
      dragging = !start.touch;
      if (dragging) moveTo(e.clientX);
    });
    ba.addEventListener('pointermove', (e) => {
      if (!start) return;
      if (!dragging) {
        const dx = Math.abs(e.clientX - start.x);
        const dy = Math.abs(e.clientY - start.y);
        if (dy > 8 && dy > dx) return void (start = null); // a scroll: let it go
        if (dx > 6 && dx > dy) dragging = true;
      }
      if (dragging) moveTo(e.clientX);
    });
    ba.addEventListener('pointerup', (e) => {
      if (start?.touch && !dragging) moveTo(e.clientX); // a tap
      start = null;
      dragging = false;
    });
    const stop = () => {
      start = null;
      dragging = false;
    };
    ba.addEventListener('pointercancel', stop);
    ba.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && stop());

    if (reduced) return;
    // first time it comes into view, the divider sweeps once to show it can be moved
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        const start = performance.now();
        const frame = (now: number) => {
          const t = Math.min(1, (now - start) / 1600);
          const v = 50 + Math.sin(t * Math.PI * 2) * 22 * (1 - t);
          set(v);
          if (t < 1 && input.value === '50') requestAnimationFrame(frame);
          else if (input.value === '50') set(50);
        };
        requestAnimationFrame(frame);
      },
      { threshold: 0.6 },
    );
    io.observe(ba);
  });
</script>
